[sub_resource type="GDScript" id="GDScript_rrcrv"]
script/source = "extends State
@onready var sprite: AnimatedSprite2D = $\"../../Sprite\"
@onready var state_owner: Enemy = $\"../..\"
@export var spawn_speed = 1.0
@onready var entity_hitbox: Hitbox = $\"../../Hitbox\"


func enter():
	state_owner.entity_hurtbox.is_hurtbox_disabled = true
	entity_hitbox.is_hitbox_disabled  = true
	sprite.play(\"spawn\", spawn_speed)
	await sprite.animation_finished
	Transistioned.emit(self, \"Chasing\")

func exit():
	entity_hitbox.is_hitbox_disabled = false
	state_owner.entity_hurtbox.is_hurtbox_disabled = false
"

[sub_resource type="GDScript" id="GDScript_5wiu6"]
resource_name = "idle"
script/source = "extends State
@onready var sprite: AnimatedSprite2D = $\"../../Sprite\"
@onready var state_owner: Enemy = $\"../..\"

var new_velocity := Vector2.ZERO
@onready var path_position = Vector2.ZERO
@export var chasing_speed = 25.0
@onready var current_tick_time = 0.0
@export var tickrate = 0.5
@onready var current_attack_time = 0.0
@export var attackrate = 3.5 + randf_range(-2.0, 2.0)

func _ready() -> void:
	state_owner.ai_navigation.velocity_computed.connect(ai_computed, 1)

func enter():
	sprite.play(\"chase\")
	state_owner.ai_navigation.target_position = global.player.global_position

func physics_update(_delta):
	var target_position_range = global.player.global_position + (Vector2.LEFT * 15).rotated(randf_range(-PI, PI))
	
	current_tick_time += _delta
	if current_tick_time > tickrate:
		current_tick_time = 0 + randf_range(0, 0.5)
		state_owner.ai_navigation.target_position = target_position_range
	
	path_position = state_owner.ai_navigation.get_next_path_position()
	new_velocity = state_owner.global_position.direction_to(path_position) * chasing_speed
	state_owner.ai_navigation.set_velocity(new_velocity)
	
	if state_owner.current_health < state_owner.maximum_health * 0.35:
		Transistioned.emit(self, \"Running\")
	
	current_attack_time += _delta
	if current_attack_time > tickrate:
		current_attack_time = 0 + randf_range(0.0, 1.0)
		attack()

func ai_computed(safe_velocity : Vector2):
	state_owner.velocity = safe_velocity

func attack():
	#Transistioned.emit(self, \"ChargingBite\")
	return
"

[sub_resource type="GDScript" id="GDScript_dtdju"]
script/source = "extends State
@onready var sprite: AnimatedSprite2D = $\"../../Sprite\"
@onready var state_owner: Enemy = $\"../..\"

var new_velocity := Vector2.ZERO
@onready var path_position = Vector2.ZERO
@export var chasing_speed = 25.0
@onready var current_tick_time = 0.0
@export var tickrate = 0.5
@onready var current_attack_time = 0.0
@export var attackrate = 3.5 + randf_range(-2.0, 2.0)

func enter():
	sprite.play(\"chase\")
	state_owner.ai_navigation.target_position = global.player.global_position

func physics_update(_delta):
	path_position = state_owner.ai_navigation.get_next_path_position()
	
	if state_owner.current_health > state_owner.maximum_health * 0.35:
		Transistioned.emit(self, \"Chasing\")
	
	if state_owner.global_position.distance_to(global.player.global_position) < 120:
		new_velocity = state_owner.global_position.direction_to(path_position).rotated(randi_range(-PI, PI) * 120) * -chasing_speed
	elif state_owner.global_position.distance_to(global.player.global_position) > 180:
		new_velocity = state_owner.global_position.direction_to(path_position) * chasing_speed
	state_owner.ai_navigation.set_velocity(new_velocity)
	
	current_tick_time += _delta
	if current_tick_time > tickrate:
		current_tick_time = 0
		state_owner.ai_navigation.target_position = global.player.global_position
	
	
	current_attack_time += _delta
	if current_attack_time > tickrate:
		current_attack_time = 0.0
		attack()

func attack():
	return
"

[sub_resource type="GDScript" id="GDScript_rnofh"]
resource_name = "hit_state"
script/source = "extends State
@onready var state_owner: Enemy = $\"../..\"
@onready var sprite: AnimatedSprite2D = $\"../../Sprite\"
@export var animation_speed := 1.0

func _ready() -> void:
	state_owner.entity_hit.connect(func(_entity : Entity): Transistioned.emit(get_parent().current_state, \"Hit\"), 1)

func enter():
	sprite.play(\"hit\", animation_speed)
	state_owner.material.set_shader_parameter(\"hit_opacity\", 1.0)
	
	await sprite.animation_finished
	
	self.Transistioned.emit(self, \"Chasing\")

func exit():
	state_owner.material.set_shader_parameter(\"hit_opacity\", 0.0)
"

[sub_resource type="GDScript" id="GDScript_2nrcc"]
resource_name = "death_state"
script/source = "extends State
@onready var state_owner: Enemy = $\"../..\"
@onready var sprite: AnimatedSprite2D = $\"../../Sprite\"
@export var animation_speed := 1.0
@onready var entity_hitbox: Hitbox = $\"../../Hitbox\"

func _ready() -> void:
	state_owner.entity_death.connect(func(_entity : Entity): Transistioned.emit(get_parent().current_state, \"Death\"), 1)

func enter():
	sprite.play(\"death\", animation_speed)
	state_owner.is_flying = false
	state_owner.entity_hurtbox.is_hurtbox_disabled = true
	entity_hitbox.is_hitbox_disabled  = true

func physics_update(_delta):
	parent.velocity = Vector2.ZERO
"

