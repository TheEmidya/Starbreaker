[sub_resource type="GDScript" id="GDScript_itgeb"]
script/source = "extends Node
@onready var player: Player = $\"..\"

@export var is_movement_disabled := false

@onready var current_movement_speed : float
@export var max_movement_speed : float
@export var base_movement_speed : float
@export_range(0.0, 1.0, 0.01, \"or_greater\") var acceleration : float
@export_range(0.0, 1.0, 0.01, \"or_greater\") var friction : float

@export_range(0, 2.0, 0.01, \"or_greater\") var speed_scalar := 1.0


func _physics_process(_delta: float) -> void:
	aim_at_mouse()
	movement_handler()

func aim_at_mouse():
	if !is_movement_disabled:
		player.look_at(player.get_global_mouse_position())

func get_direction() -> Vector2:
	var direction = Input.get_vector(\"ui_left\", \"ui_right\", \"ui_up\", \"ui_down\").normalized()
	return direction 

# Handle player movement
func movement_handler():
	if !is_movement_disabled:
		var direction = get_direction()
		
		if direction:
			current_movement_speed += lerpf(current_movement_speed, max_movement_speed, acceleration)
		else:
			current_movement_speed -= lerpf(current_movement_speed, 0, friction)
		
		player.velocity = lerp(player.velocity, direction * current_movement_speed, 15.0 * get_physics_process_delta_time())
		
		current_movement_speed = clampf(current_movement_speed, 0.0, max_movement_speed)
		current_movement_speed *= speed_scalar
		
		var slowed_movement_speed = current_movement_speed / 2.75
		if Input.is_action_pressed(\"slow\") and current_movement_speed >= slowed_movement_speed:
			current_movement_speed = slowed_movement_speed
	
	player.move_and_slide()
"

[sub_resource type="GDScript" id="GDScript_wj88f"]
script/source = "extends CanvasLayer

@onready var physics_manager: Node = $\"..\"
@onready var speed_text: Label = $\"Speed Text\"

func _ready() -> void:
	if !OS.is_debug_build():
		queue_free()

func _process(_delta: float) -> void:
	speed_text.text = \"Speed; \" + str(roundf(physics_manager.current_movement_speed))
"

[sub_resource type="GDScript" id="GDScript_xpxrt"]
script/source = "extends Node

@export_enum(\"Spray\", \"Shotgun\", \"Longshot\", \"Slash\") var weapon_selection = \"None\"
@export_enum(\"Zip-Dash\", \"DiagBomb\", \"Shine\") var utility_selection = \"None\"
@export_enum(\"BH-7\", \"Overclock\", \"Starman\") var breaker_selection = \"None\"
@export_enum(\"Classic\", \"Advanced\", \"Silence\") var ship_selection = \"None\"
@export_enum(\"Heal\", \"Boost\", \"Credit\") var passive_selection = \"None\"

var current_loadout = {
	\"weapon\" =  weapon_selection,
	\"utility\" = utility_selection,
	\"breaker\" = breaker_selection,
	\"ship\" = ship_selection,
	\"passive\" = passive_selection
}

var default_loadout = {
	\"weapon\" =  weapon_selection,
	\"utility\" = utility_selection,
	\"breaker\" = breaker_selection,
	\"ship\" = ship_selection,
	\"passive\" = passive_selection
}

@onready var active_weapon
@onready var active_utility
@onready var active_breaker
@onready var active_ship
@onready var active_passive

const SPRAYNPRAY_PATH = \"res://Game Folder/game_assets/Player/Weapons/firing_modes/Spray/Base/spray_firingmode.tscn\"
const SPLATTERSHOT_PATH = \"res://Game Folder/game_assets/Player/Weapons/firing_modes/Shotgun/Shotgun.tscn\"
const LONGSHOT_PATH = \"null\"
const ASSNINJA_PATH = \"res://Game Folder/game_assets/Player/Weapons/firing_modes/Slash/Slash.tscn\"

# Utilities
const ZIPDASH_PATH = \"res://Game Folder/game_assets/Player/Weapons/utility/Zip-Dash/zipdash.tscn\"
const SHINE_PATH = \"res://Game Folder/game_assets/Player/Weapons/utility/Shine/Shine.tscn\"
const DIAGBOMB_PATH = \"null\"

func _ready() -> void:
	update_loadout()

func _physics_process(_delta: float) -> void:
	input_handler()

func update_loadout():
	current_loadout.weapon = weapon_selection
	current_loadout.utility = utility_selection
	current_loadout.breaker = breaker_selection
	current_loadout.ship = ship_selection
	current_loadout.passive = passive_selection
	
	
	match current_loadout.weapon:
		\"Spray\":
			var weapon = load(SPRAYNPRAY_PATH) as PackedScene
			active_weapon = weapon.instantiate()
		\"Shotgun\":
			var weapon = load(SPLATTERSHOT_PATH) as PackedScene
			active_weapon = weapon.instantiate()
		\"Longshot\":
			var weapon = load(LONGSHOT_PATH) as PackedScene
			active_weapon = weapon.instantiate()
		\"Slash\":
			var weapon = load(ASSNINJA_PATH) as PackedScene
			active_weapon = weapon.instantiate()
	
	match current_loadout.utility:
		\"Shine\":
			var util = load(ZIPDASH_PATH) as PackedScene
			active_utility = util.instantiate()
		\"Zip-Dash\":
			var util = load(SHINE_PATH) as PackedScene
			active_utility = util.instantiate()
		\"DiagBomb\":
			var util = load(DIAGBOMB_PATH) as PackedScene
			active_utility = util.instantiate()

func input_handler():
	if active_utility != null:
		if Input.is_action_just_pressed(\"shift\") and active_utility.is_weapon_actionable:
			active_utility.action()
"

[sub_resource type="GDScript" id="GDScript_cvawo"]
script/source = "extends CanvasLayer

@onready var weapon_manager: Node = $\"..\"
@onready var text: Label = $\"Loadout Text\"


func _ready() -> void:
	if !OS.is_debug_build():
		queue_free()

func _process(_delta: float) -> void:
	text.text = \"Loadout; \" + str(weapon_manager.current_loadout)
"

