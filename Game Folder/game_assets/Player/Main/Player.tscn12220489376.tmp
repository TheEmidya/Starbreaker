[sub_resource type="GDScript" id="GDScript_w5s08"]
script/source = "extends AnimatedSprite2D

func _ready() -> void:
	events.player_damaged.connect(func(_current_health, _damage_taken, _colliding_hitbox): stop(); play(\"hit\"), 3)
	events.player_death.connect(func(_damage_taken, _colliding_hitbox): 
		stop()
		play(\"death\")
		if options.extra_vfx:
			$DeathEffects.emitting = true, 2)
"

