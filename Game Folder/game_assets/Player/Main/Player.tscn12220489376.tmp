[sub_resource type="GDScript" id="GDScript_u1yyx"]
script/source = "extends HurtboxComponent

func _ready() -> void:
	super()
	events.connect(\"player_death\", func(_damage_taken, _colliding_hitbox): is_disabled = true, 2)
"

