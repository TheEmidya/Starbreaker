[sub_resource type="GDScript" id="GDScript_vr0j5"]
script/source = "extends Camera2D
var current_dramatic_zoom_amount = Vector2(1.0, 1.0)
var current_shake_amount = 0.0

func _physics_process(delta: float) -> void:
	zoom_handler(delta)
	shake_handler(delta)
	if !events.is_connected(\"entity_damaged\", on_entity_hit):
		events.connect(\"entity_damaged\", on_entity_hit, 4)
		events.player_railcannon_secondary_fired.connect(func(amount : float): current_shake_amount += clamp(amount, 0.0, 15.0))
	if is_instance_valid(global.player):
		self.global_position = global.player.global_position.lerp(get_global_mouse_position(), 0.5)

func on_entity_hit(entity, current_health, previous_health, amount):
	var zoom_amount = remap(-amount, 0.0, 250.0, 1.00, 1.20)
	if current_dramatic_zoom_amount.length() < Vector2(zoom_amount, zoom_amount).length():
		current_dramatic_zoom_amount = Vector2(zoom_amount, zoom_amount)

func zoom_handler(delta : float):
	zoom = current_dramatic_zoom_amount
	current_dramatic_zoom_amount = current_dramatic_zoom_amount.slerp(Vector2(1.0, 1.0), 5.0 * delta)

func shake_handler(delta : float):
	current_shake_amount = clampf(current_shake_amount, 0.0, 15.0)
	offset = Vector2(randf_range(-current_shake_amount, current_shake_amount), randf_range(-current_shake_amount, current_shake_amount)).limit_length(15.0)
	current_shake_amount = lerpf(current_shake_amount, 0.0, 5.0 * delta)
"

