[sub_resource type="GDScript" id="GDScript_itgeb"]
script/source = "extends Node
@onready var player: Player = $\"..\"

@export var is_movement_disabled := false

@onready var current_movement_speed : float
@export var max_movement_speed : float
@export_range(0.0, 1.0, 0.01, \"or_greater\") var acceleration : float
@export_range(0.0, 1.0, 0.01, \"or_greater\") var friction : float

@export_range(0, 5.0, 0.01, \"or_greater\") var speed_scalar := 1.0


func _physics_process(_delta: float) -> void:
	aim_at_mouse()
	movement_handler()

func aim_at_mouse():
	if !is_movement_disabled:
		player.look_at(player.get_global_mouse_position())

func get_direction() -> Vector2:
	var direction = Input.get_vector(\"ui_left\", \"ui_right\", \"ui_up\", \"ui_down\").normalized()
	return direction 

# Handle player movement
func movement_handler():
	if !is_movement_disabled:
		var direction = get_direction()
		
		if direction:
			current_movement_speed += lerpf(current_movement_speed, max_movement_speed, acceleration)
		else:
			current_movement_speed -= lerpf(current_movement_speed, 0, friction)
		
		player.velocity = lerp(player.velocity, direction * current_movement_speed, 15.0 * get_physics_process_delta_time())
		
		current_movement_speed = clampf(current_movement_speed, 0.0, max_movement_speed)
		current_movement_speed *= speed_scalar
		
		var slowed_movement_speed = current_movement_speed / 2.75
		if Input.is_action_pressed(\"slow\") and current_movement_speed >= slowed_movement_speed:
			current_movement_speed = slowed_movement_speed
	
	player.move_and_slide()
"

[sub_resource type="GDScript" id="GDScript_xpxrt"]
script/source = "extends Node

@export var maximum_energy := 100.0
@onready var current_energy := maximum_energy:
	set(value):
		var previous_energy = current_energy
		
		if ship_selection == \"Advanced\":
			value *= 2.75 # 175%
		
		current_energy += value
		
		current_energy = clampf(current_energy, 0, maximum_energy)
		events.energy_updated.emit([current_energy, value, previous_energy])
@export var energy_per_second := 5.0
@onready var is_max_energy = false:
	get:
		if current_energy >= maximum_energy:
			if is_max_energy == false:
				events.max_energy_reached.emit()
			is_max_energy = true
		else:
			if is_max_energy == true:
				events.max_energy_lost.emit()
			is_max_energy = false
		return is_max_energy

@export_enum(\"None\", \"Railcannon\", \"Shotgun\", \"Longshot\", \"Slash\") var weapon_selection = \"None\":
	set(value):
		weapon_selection = value
		update_loadout(weapon_selection)
@export_enum(\"None\", \"Zip-Dash\", \"DiagBomb\", \"Shine\") var utility_selection = \"None\":
	set(value):
		utility_selection = value
		update_loadout(utility_selection)
@export_enum(\"None\", \"LZ-R\", \"Overclock\", \"Starman\") var breaker_selection = \"None\":
	set(value):
		breaker_selection = value
		update_loadout(breaker_selection)
@export_enum(\"None\", \"Classic\", \"Advanced\", \"Stealth\") var ship_selection = \"None\":
	set(value):
		ship_selection = value
		update_loadout(ship_selection)
@export_enum(\"None\", \"Heal\", \"Man\", \"Credit\") var passive_selection = \"None\":
	set(value):
		passive_selection = value
		update_loadout(passive_selection)

var current_loadout = {
	\"weapon\" =  weapon_selection,
	\"utility\" = utility_selection,
	\"breaker\" = breaker_selection,
	\"ship\" = ship_selection,
	\"passive\" = passive_selection
}

@onready var active_weapon
@onready var active_utility
@onready var active_breaker
@onready var active_ship
@onready var active_passive

# Weapons
const RAILCANNON_PATH = \"res://Game Folder/game_assets/Player/Weapons/firing_modes/Railcannon/Base/railcannon_weapon.tscn\"
const SPLATTERSHOT_PATH = \"res://Game Folder/game_assets/Player/Weapons/firing_modes/Shotgun/Shotgun.tscn\"
const LONGSHOT_PATH = \"null\"
const ASSNINJA_PATH = \"res://Game Folder/game_assets/Player/Weapons/firing_modes/Slash/Slash.tscn\"

# Utilities
const ZIPDASH_PATH = \"res://Game Folder/game_assets/Player/Weapons/utility/Zip-Dash/zipdash.tscn\"
const SHINE_PATH = \"res://Game Folder/game_assets/Player/Weapons/utility/Shine/Shine.tscn\"
const DIAGBOMB_PATH = \"null\"
const SHOCKWAVE = \"null\"

# Breakers
const STARMAN_PATH = \"res://Game Folder/game_assets/Player/Breaker/Starman/starman.tscn\"
const LZR_PATH = \"res://Game Folder/game_assets/Player/Breaker/LZ-R/lz_r.tscn\"

# Ship
const CLASSICSHIP_PATH = \"res://Game Folder/game_assets/Player/Ship/Classic/classicship.tscn\"
const ADVANCEDSHIP_PATH = \"res://Game Folder/game_assets/Player/Ship/Advanced/advanced.tscn\"
const STEALTHSHIP_PATH = \"res://Game Folder/game_assets/Player/Ship/Stealth/ship_stealth.tscn\"

# Passives
const HEAL_PATH = \"res://Game Folder/game_assets/Player/Passive/Heal Passive/Heal.tscn\"
const MAN_PATH = \"res://Game Folder/game_assets/Player/Passive/Man Passive/man_passive.tscn\"

func _ready() -> void:
	events.hitbox_impact.connect(grant_on_hit_energy, 2)

func _physics_process(delta: float) -> void:
	update_energy(delta)

func update_loadout(value : String):
	current_loadout.weapon = weapon_selection
	current_loadout.utility = utility_selection
	current_loadout.breaker = breaker_selection
	current_loadout.ship = ship_selection
	current_loadout.passive = passive_selection
	
	if value == current_loadout.weapon:
		for bonus in get_children():
			if bonus is Weapon:
				bonus.queue_free()
		match current_loadout.weapon:
			\"Railcannon\":
				var weapon = load(RAILCANNON_PATH) as PackedScene
				active_weapon = weapon.instantiate() as Weapon
			\"Shotgun\":
				var weapon = load(SPLATTERSHOT_PATH) as PackedScene
				active_weapon = weapon.instantiate() as Weapon
			\"Longshot\":
				var weapon = load(LONGSHOT_PATH) as PackedScene
				active_weapon = weapon.instantiate() as Weapon
			\"Slash\":
				var weapon = load(ASSNINJA_PATH) as PackedScene
				active_weapon = weapon.instantiate() as Weapon
		if active_weapon:
			add_child(active_weapon, true)
	
	if value == current_loadout.utility:
		for bonus in get_children():
			if bonus is Node:
				pass
		match current_loadout.utility:
			\"Shine\":
				var util = load(ZIPDASH_PATH) as PackedScene
				active_utility = util.instantiate() as Node
			\"Zip-Dash\":
				var util = load(SHINE_PATH) as PackedScene
				active_utility = util.instantiate() as Node
			\"DiagBomb\":
				var util = load(DIAGBOMB_PATH) as PackedScene
				active_utility = util.instantiate() as Node
		if active_utility:
			add_child(active_utility, true)
	
	if value == current_loadout.breaker:
		for bonus in get_children():
			if bonus is Breaker:
				bonus.queue_free()
		match current_loadout.breaker:
			\"LZ-R\":
				var breaker = load(LZR_PATH) as PackedScene
				active_breaker = breaker.instantiate() as Breaker
			\"Overclock\":
				pass
			\"Starman\":
				var breaker = load(STARMAN_PATH) as PackedScene
				active_breaker = breaker.instantiate() as Breaker
		if active_breaker:
			add_child(active_breaker, true)
	
	if value == current_loadout.ship:
		for bonus in get_children():
			if bonus is Ship:
				bonus.queue_free()
		match current_loadout.ship:
			\"Classic\":
				var ship = load(CLASSICSHIP_PATH) as PackedScene
				active_ship = ship.instantiate() as Ship
			\"Advanced\":
				var ship = load(ADVANCEDSHIP_PATH) as PackedScene
				active_ship = ship.instantiate() as Ship
			\"Stealth\":
				var ship = load(STEALTHSHIP_PATH) as PackedScene
				active_ship = ship.instantiate() as Ship
		if active_ship:
			add_child(active_ship, true)
	
	if value == current_loadout.passive:
		for bonus in get_children():
			if bonus is Passive:
				bonus.queue_free()
		match current_loadout.passive:
			\"Heal\":
				var passive = load(HEAL_PATH) as PackedScene
				active_passive = passive.instantiate() as Passive
			\"Man\":
				var passive = load(MAN_PATH) as PackedScene
				active_passive = passive.instantiate() as Passive
			\"Credit\":
				pass
		if active_passive:
			add_child(active_passive, true)

func update_energy(delta : float):
	current_energy = energy_per_second * delta

func grant_on_hit_energy(_hit_entity : Entity, hitbox_data : Dictionary):
	if hitbox_data.hitbox_team == \"Player\":
		current_energy = hitbox_data.damage / 10
"

[sub_resource type="GDScript" id="GDScript_lrwhw"]
script/source = "extends CanvasLayer
@onready var current_selection_time := 0.0
@export var maximum_selection_time := 6.5
@export var time_progressbar: ProgressBar

@export_enum(\"CLOSED\", \"SELECTION\", \"MINIGAME\") var menu_state = \"CLOSED\"
@export var animation: AnimationPlayer

func _ready() -> void:
	events.connect(\"upgrade\", init_upgrade_minigame, 1)

func init_upgrade_minigame(upgrade_uid : String):
	print(upgrade_uid)
	show()
	animation.play(\"Opening\")
	await animation.animation_finished
	menu_state = \"SELECTION\"
	current_selection_time = 0.0

func _physics_process(delta: float) -> void:
	if current_selection_time < maximum_selection_time and menu_state == \"SELECTION\":
		current_selection_time += delta
		time_progressbar.value = remap(current_selection_time, 0.0, maximum_selection_time, 0.0, 100.0)
		if current_selection_time >= maximum_selection_time:
			menu_state = \"MINIGAME\"
			animation.play(\"Closing\")
"

