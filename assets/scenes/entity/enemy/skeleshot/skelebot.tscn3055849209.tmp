[sub_resource type="GDScript" id="GDScript_cu4nj"]
script/source = "extends StateClass
@onready var ai_navigation: NavigationAgent2D = %AI_Navigation
@onready var entity: EnemyEntityClass = $\"../..\"

func physics_update(_delta):
	ai_navigation.target_position = global.player.global_position
	if ai_navigation.is_navigation_finished():
		return
	
	var next_point = ai_navigation.get_next_path_position()
	var direction = (next_point - entity.global_position).normalized()
	var desired_velocity = entity.velocity.move_toward(direction * entity.entity_movement_class.entity_movement_speed, entity.entity_movement_class.entity_acceleration)
	
	ai_navigation.set_velocity(desired_velocity)

func _on_ai_navigation_velocity_computed(safe_velocity: Vector2) -> void:
	entity.velocity = safe_velocity
	print(entity.velocity, safe_velocity)
"

