[sub_resource type="GDScript" id="GDScript_essvl"]
resource_name = "gamecore_script"
script/source = "extends Node
const SCENE_DICT := {
	\"MAIN_MENU\" : preload(\"uid://c8cl1sli3qnjh\"),
	\"STAGE_TUTORIAL\" : preload(\"uid://bt2463d5pn3rg\"),
	\"STAGE_TRES2B\" : preload(\"uid://dsoc2yii2o420\"),
	\"STAGE_TAUBOOTIS\" : preload(\"uid://sseu563vh7yb\"),
	}

func _enter_tree() -> void:
	global.main_manager = self

func _exit_tree() -> void:
	push_error(\"WHAT??? How did the game core get removed from the scene tree? Are you stupid?\")
	global.main_manager = null

func _ready():
	var mainmenu_scene = load_scene(SCENE_DICT.MAIN_MENU)
	mainmenu_scene.play.connect(play_sequence)

func play_sequence():
	load_scene(SCENE_DICT.STAGE_TRES2B)

func load_scene(packed : PackedScene):
	if packed is PackedScene:
		var loaded_packed = packed.instantiate()
		add_child(loaded_packed)
		return loaded_packed
"

